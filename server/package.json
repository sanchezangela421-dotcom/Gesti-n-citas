    "db:backfill-fields": "ts-node src/scripts/backfillOrgFields.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
