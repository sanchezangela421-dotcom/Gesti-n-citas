# ── Configuración del backend ────────────────────────────────────────────────
# Copia este archivo como server/.env y rellena los valores:
#   cd server && cp .env.example .env
#
# (El .env.example de la raíz es distinto: ese es para docker-compose.)

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_citas"

# Base para las pruebas automatizadas. Si se omite, se deriva de DATABASE_URL
# añadiendo el sufijo _test. Debe terminar en "_test": la suite se niega a
# arrancar si no, para no truncar la base de desarrollo entre pruebas.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_citas_test"

# ── Autenticación ────────────────────────────────────────────────────────────
# Genera uno propio:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"

# Nota: ALLOWED_EMAIL_DOMAIN ya no existe. Quién puede registrarse lo decide
# ahora CADA ORGANIZACIÓN, no el proceso: una sola variable global no podía
# expresar a la vez el dominio de una escuela y que el paciente de un hospital
# llega con el correo que tenga. Se configura desde el panel del superadmin
# (modo de registro + dominios). Ver server/src/lib/registration.ts.

# ── URLs ─────────────────────────────────────────────────────────────────────
# FRONTEND_URL se usa en los enlaces de los correos y para el CORS.
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# ── Panel de superadmin ──────────────────────────────────────────────────────
# Lista de IPs separadas por coma que pueden acceder. Vacío = sin restricción.
# En producción conviene restringirlo.
SUPERADMIN_ALLOWED_IPS=""

# ── Correo ───────────────────────────────────────────────────────────────────
# Para desarrollo y QA se recomienda Mailtrap: captura todos los correos en una
# bandeja de prueba en vez de enviarlos a direcciones reales.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="tu_usuario_mailtrap"
SMTP_PASS="tu_password_mailtrap"
SMTP_FROM="noreply@tudominio.com"

# ── Siembra de datos de prueba ───────────────────────────────────────────────
# Contraseña de las cuentas que crea `pnpm db:seed`. No tiene valor por defecto
# a propósito: antes vivía escrita en prisma/seed.ts, y ese archivo es público.
# El seed además se niega a correr con NODE_ENV=production.
#   SEED_PASSWORD="$(node -e 'console.log(require(\"crypto\").randomBytes(12).toString(\"base64url\"))')"
SEED_PASSWORD=""

# ── Otros ────────────────────────────────────────────────────────────────────
# Zona horaria del servidor: las citas se interpretan en esta zona.
TZ="America/Monterrey"

# Número de proxies inversos delante del backend (nginx del compose = 1).
# 0 si se expone directo. Afecta al rate limit y al allowlist de IPs.
TRUST_PROXY="1"

# ── Recordatorios de cita (24 h antes) ──────────────────────────────────────
# El planificador vive en el propio proceso del backend (services/
# appointmentReminders.ts) y revisa las citas CONFIRMADAS de mañana.
# Es idempotente: se apoya en Appointment.reminderSentAt, así que varias
# instancias del servidor no duplican el correo.
REMINDERS_ENABLED="true"
# Cada cuántos minutos revisa. Cada hora basta: el margen es de 24 h.
REMINDERS_INTERVAL_MINUTES="5"

# ── Ritmo de envío de correo ────────────────────────────────────────────────
# Todo el correo del sistema sale por una sola cola (services/email.ts), de uno
# en uno. Separación mínima entre envíos, en milisegundos.
#
# 1100 encaja con los planes de prueba que permiten 1 correo por segundo. Con un
# proveedor de pago se puede bajar, pero NO conviene 0: enviar en ráfaga es la
# forma más rápida de que limiten la cuenta o marquen al remitente.
EMAIL_MIN_INTERVAL_MS="1100"
# Reintentos cuando el proveedor pide bajar el ritmo (la espera crece en cada uno).
# Un rechazo por otro motivo (destinatario inválido, credenciales) no se reintenta.
EMAIL_MAX_RETRIES="3"

# ── Límite de peticiones ────────────────────────────────────────────────────
# El tope es POR IP. Sube estos valores SOLO en desarrollo: un emulador que
# muestra varios tamaños de pantalla a la vez multiplica cada carga, y una sala
# probando desde el mismo wifi sale con una única IP pública — la cuota se agota
# sin que nadie abuse. En producción, déjalos sin definir.
RATE_LIMIT_MAX="500"        # peticiones a /api por IP cada 15 minutos
AUTH_RATE_LIMIT_MAX="15"    # intentos de acceso/registro por IP cada 15 minutos
