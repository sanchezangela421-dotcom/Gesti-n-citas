datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  alumno      // usuario de org tipo escuela
  usuario     // usuario de org tipo empresa u hospital
  especialista
  admin
  superadmin
}

// ── Platform models ────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  type          String   // "school" | "hospital" | "company"
  plan          String   @default("free")
  active        Boolean  @default(true)
  userRoleLabel String   @default("Usuario") // "Alumno" | "Paciente" | "Empleado"
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              User[]
  specialists        Specialist[]
  appointments       Appointment[]
  events             AppEvent[]
  resources          Resource[]
  periods            ReportPeriod[]
  notifications      Notification[]
  registrationFields RegistrationField[]
  clinicalNotes      ClinicalNote[]
}

// Campos personalizados que cada org pide al registrarse
model RegistrationField {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String       // identificador interno: "matricula", "numero_empleado"
  label          String       // etiqueta visible: "Número de Control", "No. Empleado"
  type           String       // "text" | "number" | "select" | "date" | "radio"
  required       Boolean      @default(false)
  order          Int          @default(0)
  options        Json?        // para "select" y "radio": ["ISC", "IEC", ...]
  placeholder    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
  @@index([organizationId, order])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String
  actorRole      String
  action         String
  targetEntity   String
  targetId       String
  organizationId String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
}

// ── Business models ────────────────────────────────────────────────────────────

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  password                    String
  name                        String
  role                        UserRole
  matricula                   String?
  carrera                     String?
  semestre                    Int?
  fechaNacimiento             String?
  genero                      String?
  department                  String?
  avatarUrl                   String?
  metadata                    Json?     // campos dinámicos definidos por la org (RegistrationField)
  emailVerified               Boolean   @default(false)
  verificationToken           String?
  verificationTokenExpiresAt  DateTime?
  resetPasswordToken          String?
  resetPasswordTokenExpiresAt DateTime?
  tokenVersion                Int       @default(0) // se incrementa para invalidar JWTs emitidos previamente
  organizationId              String?
  organization                Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  specialist          Specialist?
  studentAppointments Appointment[]  @relation("StudentAppointments")
  notifications       Notification[]
  clinicalNotes       ClinicalNote[] @relation("StudentClinicalNotes")

  @@index([organizationId, role])
  @@index([organizationId, email])
}

model Specialist {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  department     String
  email          String
  active         Boolean       @default(true)
  shift          String?
  meetingUrl     String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?     // soft-delete: el expediente clínico sobrevive (retención NOM-004)

  schedules     ScheduleSlot[]
  appointments  Appointment[]  @relation("SpecialistAppointments")
  clinicalNotes ClinicalNote[]

  @@index([organizationId, active])
  @@index([organizationId, department])
}

model ScheduleSlot {
  id           String     @id @default(uuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  available    Boolean    @default(true)
  week         Int?
  specificDate String?
}

model ReportPeriod {
  id             String        @id @default(uuid())
  name           String
  startDate      String
  endDate        String?
  status         String        @default("activo")
  closedAt       DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  appointments Appointment[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model Appointment {
  id             String        @id @default(uuid())
  studentId      String
  student        User          @relation("StudentAppointments", fields: [studentId], references: [id], onDelete: Cascade)
  studentName    String
  specialistId   String
  specialist     Specialist    @relation("SpecialistAppointments", fields: [specialistId], references: [id], onDelete: Cascade)
  specialistName String
  department     String
  date           String
  time           String
  status         String        @default("Pendiente")
  modality       String
  motivo         String
  cancellationReason String?   // motivo de cancelación (NO confidencial; visible al alumno)
  meetingUrl     String?
  isFollowUp     Boolean       @default(false)
  parentId       String?
  parent         Appointment?  @relation("AppointmentFollowUps", fields: [parentId], references: [id], onDelete: SetNull)
  followUps      Appointment[] @relation("AppointmentFollowUps")
  clinicalNote   ClinicalNote?
  periodId       String?
  period         ReportPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, studentId])
  @@index([organizationId, specialistId])
  @@index([organizationId, createdAt])
}

model AppEvent {
  id              String        @id @default(uuid())
  title           String
  description     String
  department      String
  date            String
  time            String
  type            String
  imageUrl        String?
  registrationUrl String?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, type])
}

model Resource {
  id             String        @id @default(uuid())
  department     String
  type           String
  title          String
  description    String
  url            String
  imageUrl       String?
  fileUrl        String?
  fileName       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, type])
  @@index([organizationId, department])
}

model Notification {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  time           String
  read           Boolean       @default(false)
  type           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, read])
}

// ── Clinical record ────────────────────────────────────────────────────────────

// Nota clínica confidencial de una cita. Visibilidad: autor + continuidad por
// departamento (ver project_clinical_notes_plan). El filtrado se hace en la capa
// de aplicación (org + departamento + relación de atención), nunca solo aquí.
model ClinicalNote {
  id             String        @id @default(uuid())
  appointmentId  String        @unique
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  specialistId   String        // autor — Specialist.id
  specialist     Specialist    @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  studentId      String        // paciente — denormalizado para el expediente
  student        User          @relation("StudentClinicalNotes", fields: [studentId], references: [id], onDelete: Cascade)
  department     String        // depto de atención — denormalizado para continuidad por depto
  organizationId String?       // aislamiento por organización
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  body           String        // contenido confidencial
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  revisions      ClinicalNoteRevision[]

  @@index([organizationId, department, studentId]) // consulta de continuidad por depto
  @@index([specialistId, studentId])               // notas propias del especialista
  @@index([studentId])
}

// Historial inmutable de ediciones de una nota clínica (integridad NOM-004).
// Cada edición copia aquí el cuerpo ANTERIOR antes de sobrescribir la nota.
model ClinicalNoteRevision {
  id                   String       @id @default(uuid())
  noteId               String
  note                 ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  body                 String       // snapshot del contenido anterior
  editedBySpecialistId String       // quién editó (Specialist.id) — escalar, registro histórico
  createdAt            DateTime     @default(now())

  @@index([noteId, createdAt])
}
