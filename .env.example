# ── Copia este archivo como .env y rellena los valores ──────────────────────
# cp .env.example .env

# Base de datos PostgreSQL (usada por docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto_por_password_seguro
POSTGRES_DB=gestion_citas

# URL pública donde vive la app (la ven los emails y el CORS)
# Local:  http://localhost
# ngrok:  https://abc123.ngrok-free.app
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api

# JWT — genera uno seguro:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# Dominio permitido para registro de usuarios
ALLOWED_EMAIL_DOMAIN=mail.com

# IPs permitidas para el panel superadmin (vacío = sin restricción)
SUPERADMIN_ALLOWED_IPS=

# SMTP (Mailtrap para pruebas, tu proveedor real en producción)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu_usuario_mailtrap
SMTP_PASS=tu_password_mailtrap
SMTP_FROM=noreply@tudominio.com

# Número de proxies inversos delante del backend (nginx del compose = 1).
# 0 si el backend se expone directo sin proxy; 2 si además hay un CDN delante.
TRUST_PROXY=1

# Zona horaria del backend — las citas se interpretan en esta zona.
TZ=America/Monterrey
